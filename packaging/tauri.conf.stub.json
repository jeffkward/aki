{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Aki",
  "version": "0.1.0",
  "identifier": "com.example.aki",
  "build": { "frontendDist": "../public", "devUrl": "http://localhost:8787" },
  "app": {
    "windows": [
      {
        "title": "aki",
        "width": 1100,
        "height": 800,
        "url": "http://localhost:8787",
        "resizable": true
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "app"],
    "icon": ["../assets/aki.icns"],
    "externalBin": ["binaries/aki"],
    "macOS": {
      "minimumSystemVersion": "13.0",
      "entitlements": "../packaging/entitlements.plist"
    }
  }
}
